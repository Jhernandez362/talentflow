    { "parameters": { "resource": "message", "operation": "sendMessage", "chatId": "={{ $('Build context').first().json.chat_id }}", "text": "TalentFlow RRHH\n\nPuedes preguntarme sobre candidatos, vacantes y resultados, o usar los botones de abajo.", "replyMarkup": "inlineKeyboard", "inlineKeyboard": { "rows": [ { "row": { "buttons": [ { "text": "👥 Candidatos", "additionalFields": { "callback_data": "bot_candidatos" } }, { "text": "💼 Vacantes", "additionalFields": { "callback_data": "bot_vacantes" } } ] } }, { "row": { "buttons": [ { "text": "⏳ Pendientes", "additionalFields": { "callback_data": "bot_pendientes" } }, { "text": "📊 Métricas", "additionalFields": { "callback_data": "bot_metricas" } } ] } } ] }, "additionalFields": {} }, "id": "send-welcome", "name": "Send welcome", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1440, -160] },
