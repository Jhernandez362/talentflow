    { "parameters": { "updates": ["message", "callback_query"] }, "id": "trigger", "name": "Telegram Trigger", "type": "n8n-nodes-base.telegramTrigger", "typeVersion": 1.4, "position": [0, 0], "webhookId": "tf-bot-00-telegram-assistant" },
    { "parameters": { "jsCode": "const isCallback = !!$json.callback_query;\nconst msg = isCallback ? $json.callback_query.message : $json.message;\nconst from = isCallback ? $json.callback_query.from : $json.message?.from;\nconst telegramUserId = from?.id ?? null;\nconst chatId = msg?.chat?.id ?? null;\nconst callbackData = isCallback ? String($json.callback_query.data ?? '') : '';\nconst text = isCallback ? '' : String($json.message?.text ?? '').trim();\nconst isStart = !isCallback && (text === '/start' || text.startsWith('/start '));\nif (!telegramUserId || !chatId) throw new Error('BOT_INPUT_MISSING_IDENTITY: no se pudo identificar al usuario o chat de Telegram');\nreturn [{ json: { telegram_user_id: telegramUserId, chat_id: chatId, is_callback: isCallback, callback_data: callbackData, text, is_start: isStart } }];" }, "id": "normalize", "name": "Normalize input", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [240, 0] },
    { "parameters": { "operation": "executeQuery", "query": "SELECT EXISTS (SELECT 1 FROM talentflow.vw_bot_authorized_users WHERE telegram_user_id = $1 AND is_active = true) AS autorizado", "options": { "queryReplacement": "={{ [$json.telegram_user_id] }}" } }, "id": "check-auth", "name": "Check authorization", "type": "n8n-nodes-base.postgres", "typeVersion": 2.6, "position": [480, 0] },
    { "parameters": { "jsCode": "const norm = $('Normalize input').item.json;\nconst autorizado = $json.autorizado === true;\nreturn [{ json: { ...norm, autorizado } }];" }, "id": "build-context", "name": "Build context", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [720, 0] },
