    { "parameters": { "source": "database", "workflowId": { "__rl": true, "value": "tf-bot-02-listar-candidatos", "mode": "list", "cachedResultName": "TF-BOT-02 Listar candidatos" }, "workflowInputs": { "mappingMode": "defineBelow", "value": { "estado": "", "limite": 8 }, "matchingColumns": [], "schema": [{ "id": "estado", "displayName": "estado", "required": false, "display": true, "canBeUsedToMatch": true, "type": "string" }, { "id": "limite", "displayName": "limite", "required": false, "display": true, "canBeUsedToMatch": true, "type": "number" }], "attemptToConvertTypes": false, "convertFieldsToString": true }, "options": { "waitForSubWorkflow": true } }, "id": "call-candidatos", "name": "Call listar_candidatos", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1.3, "position": [1920, -160] },
    { "parameters": { "source": "database", "workflowId": { "__rl": true, "value": "tf-bot-06-listar-vacantes", "mode": "list", "cachedResultName": "TF-BOT-06 Listar vacantes" }, "workflowInputs": { "mappingMode": "defineBelow", "value": { "estado": "", "limite": 8 }, "matchingColumns": [], "schema": [{ "id": "estado", "displayName": "estado", "required": false, "display": true, "canBeUsedToMatch": true, "type": "string" }, { "id": "limite", "displayName": "limite", "required": false, "display": true, "canBeUsedToMatch": true, "type": "number" }], "attemptToConvertTypes": false, "convertFieldsToString": true }, "options": { "waitForSubWorkflow": true } }, "id": "call-vacantes", "name": "Call listar_vacantes", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1.3, "position": [2160, -60] },
