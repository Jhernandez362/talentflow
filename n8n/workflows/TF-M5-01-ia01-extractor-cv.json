      },
      "id": "download-cv", "name": "Download valid CV",
      "type": "n8n-nodes-base.googleDrive", "typeVersion": 3, "position": [480, 0],
      "credentials": { "googleDriveOAuth2Api": { "id": "oAIJxsT0bXNRwRsx", "name": "Google Drive account" } }
    },
    {
      "parameters": {
        "operation": "pdf", "binaryPropertyName": "data",
