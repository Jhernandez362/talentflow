  "nodes": [
    { "parameters": { "workflowInputs": { "values": [{ "name": "postulacion_id", "type": "string" }] } }, "id": "input", "name": "Input postulacion_id", "type": "n8n-nodes-base.executeWorkflowTrigger", "typeVersion": 1.1, "position": [0, 0] },
    { "parameters": { "operation": "executeQuery", "query": "SELECT talentflow.ia02_begin_summary($1::uuid, $2, $3) AS data", "options": { "queryReplacement": "={{ [$json.postulacion_id, 'google-gemini', 'gemini-3.6-flash'] }}" } }, "id": "begin", "name": "Begin IA-02 summary", "type": "n8n-nodes-base.postgres", "typeVersion": 2.6, "position": [240, 0], "credentials": { "postgres": { "id": "yV1LeJCuuqdkS03D", "name": "Postgres account" } } },
    { "parameters": { "jsCode": "const c=$json.data; const prompt=`Genera un resumen corto, profesional, objetivo y neutral usando EXCLUSIVAMENTE los datos suministrados. No inventes empresas, tecnologías, responsabilidades, años, certificaciones ni títulos. No uses características protegidas. No recomiendes contratación ni descarte. No cambies ni recalcules el score. Si lo mencionas usa exactamente el recibido. Prioriza experiencia relevante, tecnologías, educación, fortalezas objetivas y requisitos cumplidos o faltantes. No uses lenguaje valorativo. Devuelve solo JSON con summary y key_points.\\n\\ncandidate_structured_data=${JSON.stringify(c.candidate_structured_data)}\\nscore_breakdown=${JSON.stringify(c.score_breakdown)}\\nvacancy_title=${JSON.stringify(c.vacancy_title)}\\nvacancy_requirements=${JSON.stringify(c.vacancy_requirements)}`; return [{json:{prompt,analysis_id:c.analysis_id}}];" }, "id": "prompt", "name": "Prepare PROMPT-IA-02-v1", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [480, 0] },
    { "parameters": { "promptType": "define", "text": "={{ $json.prompt }}", "hasOutputParser": true, "needsFallback": true, "batching": { "batchSize": 1, "delayBetweenBatches": 0 } }, "id": "ia", "name": "IA-02 Summary", "type": "@n8n/n8n-nodes-langchain.chainLlm", "typeVersion": 1.9, "position": [720, 0], "retryOnFail": false, "onError": "continueRegularOutput" },
    { "parameters": { "modelName": "gemini-3.6-flash", "options": { "temperature": 0.1, "maxOutputTokens": 2048 } }, "id": "model", "name": "Gemini 3.6 Flash", "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini", "typeVersion": 1.1, "position": [640, 240], "credentials": { "googlePalmApi": { "id": "1rM8abptN561zj2o", "name": "Google Gemini(PaLM) Api account" } } },
    { "parameters": { "model": "openai/gpt-oss-20b", "options": { "temperature": 0.1, "maxTokensToSample": 2048 } }, "id": "groq-fallback-model", "name": "Groq GPT-OSS 20B (fallback)", "type": "@n8n/n8n-nodes-langchain.lmChatGroq", "typeVersion": 1, "position": [640, 420] },
    { "parameters": { "schemaType": "manual", "inputSchema": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"summary\",\"key_points\"],\"properties\":{\"summary\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1200},\"key_points\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":8,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":300}}}}", "autoFix": true }, "id": "parser", "name": "IA-02 Structured Output", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "typeVersion": 1.3, "position": [880, 240] },
    { "parameters": { "jsCode": "if($json.error)return[{json:{valid:false,error:String($json.error)}}]; const d=$json.output??$json; const banned=/(debe contratarse|debe rechazarse|candidato excelente|candidato débil)/i; const valid=d&&typeof d.summary==='string'&&d.summary.trim()&&!banned.test(d.summary)&&Array.isArray(d.key_points)&&d.key_points.length>=1&&d.key_points.length<=8&&d.key_points.every(x=>typeof x==='string'&&x.trim()); return [{json:valid?{valid:true,result_json:JSON.stringify(d)}:{valid:false,error:'IA02_INVALID_OUTPUT'}}];" }, "id": "validate", "name": "Validate IA-02 output", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1000, 0] },
    { "parameters": { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 }, "conditions": [{ "id": "m7-ia02-valid", "leftValue": "={{ $json.valid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } }, "id": "if", "name": "Output is valid", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1240, 0] },
    { "parameters": { "operation": "executeQuery", "query": "SELECT talentflow.ia02_complete_summary($1::uuid, $2::jsonb) AS data", "options": { "queryReplacement": "={{ [$('Begin IA-02 summary').first().json.data.analysis_id, $json.result_json] }}" } }, "id": "success", "name": "Record IA-02 success", "type": "n8n-nodes-base.postgres", "typeVersion": 2.6, "position": [1480, -100], "credentials": { "postgres": { "id": "yV1LeJCuuqdkS03D", "name": "Postgres account" } } },
    { "parameters": { "operation": "executeQuery", "query": "SELECT talentflow.ia02_fail_summary($1::uuid, $2) AS data", "options": { "queryReplacement": "={{ [$('Begin IA-02 summary').first().json.data.analysis_id, $json.error || 'IA-02 output invalid'] }}" } }, "id": "failure", "name": "Record IA-02 failure", "type": "n8n-nodes-base.postgres", "typeVersion": 2.6, "position": [1480, 100], "credentials": { "postgres": { "id": "yV1LeJCuuqdkS03D", "name": "Postgres account" } } }
