# Zona horaria compartida por todos los servicios
TZ=America/Bogota

# Puertos publicados en el host (cambielos si ya estan ocupados)
POSTGRES_HOST_PORT=5432
N8N_HOST_PORT=5678
FRONTEND_HOST_PORT=5173

# PostgreSQL (valores locales de ejemplo; use secretos robustos fuera de desarrollo)
POSTGRES_DB=talentflow
POSTGRES_USER=talentflow_app
POSTGRES_PASSWORD=change_me_for_local_development

# n8n
# Genere una clave larga y aleatoria. No la cambie despues de guardar credenciales en n8n.
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_encryption_key
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# URL que abre el navegador desde el host. Para trafico entre contenedores use http://n8n:5678.
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678

# Modulo 9: rol Postgres de solo lectura para el bot de Telegram (migracion 027).
# Genere la contrasena real con ALTER ROLE tras aplicar la migracion; no reutilice este valor.
TALENTFLOW_BOT_READONLY_USER=talentflow_bot_readonly
TALENTFLOW_BOT_READONLY_PASSWORD=change_me_for_local_development
